---
import "../styles/global.css";
import { appStoreUrl, localizedPath, siteUrl } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { getTranslation, richTextToPlain } from "../lib/translations";
import { DeviceMockupsSection } from "./device-mockups-section";
import { DocsBasicsSection } from "./docs-basics-section";
import { FAQSection } from "./faq-section";
import { FeatureCardsSection } from "./feature-cards-section";
import { Footer } from "./footer";
import { Experience } from "./experience/experience";
import { StatementLink } from "./mg/statement-link";
import PageHead from "./page-head.astro";
import { PerformanceSection } from "./performance-section";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const meta = t.meta.home;
const screenStudioAlternative = t.home.screenStudioAlternative;
const docsBasicsCopy = {
  emptyVideoDescription: t.docs.emptyVideoDescription,
  emptyVideoTitle: t.docs.emptyVideoTitle,
  eyebrow: t.docs.eyebrow,
  feature: t.docs.features.basics,
  playback: t.docs.playback,
  progressLabel: t.docs.progressLabel,
  title: t.docs.title,
  videoAriaLabel: t.docs.videoAriaLabel,
};
const softwareApplicationStructuredData = {
  "@type": "SoftwareApplication",
  "@id": `${siteUrl}/#software`,
  name: "ScreenCam",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 15+",
  url: siteUrl,
  image: `${siteUrl}/og.jpg`,
  downloadUrl: appStoreUrl,
  description: meta.description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    url: appStoreUrl,
  },
  featureList: t.home.structuredDataFeatureList,
};
const faqStructuredData = {
  "@type": "FAQPage",
  "@id": `${siteUrl}${localizedPath(locale, "/")}#faq-schema`,
  mainEntity: t.home.faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: richTextToPlain(item.answer),
    },
  })),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [softwareApplicationStructuredData, faqStructuredData],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead
      locale={locale}
      path="/"
      title={meta.title}
      description={meta.description}
      robots="index, follow, max-image-preview:large"
      structuredData={structuredData}
    />
  </head>
  <body class="font-sans antialiased bg-background">
    <main>
      <Experience
        copy={t.home.hero}
        currentPath="/"
        headerCopy={t.header}
        languageLabel={t.footer.language}
        locale={locale}
        client:load
      />
      <DeviceMockupsSection copy={t.home.deviceMockups} client:load />
      <PerformanceSection copy={t.home.performance} client:load />
      <FeatureCardsSection copy={t.home.featureCards} client:load />
      <StatementLink
        eyebrow={screenStudioAlternative.eyebrow}
        title={screenStudioAlternative.title}
        description={screenStudioAlternative.description}
        cta={screenStudioAlternative.cta}
        href={localizedPath(locale, "/screen-studio-alternative")}
        client:load
      />
      <DocsBasicsSection copy={docsBasicsCopy} docsHref={localizedPath(locale, "/docs")} client:load />
      <FAQSection copy={t.home.faq} sectionIndex={7} client:load />
      <Footer copy={t.footer} locale={locale} client:load />
    </main>
  </body>
</html>
