---
import "../styles/global.css";
import type { Locale } from "../lib/i18n";
import { defaultLocale, localizedPath, siteUrl } from "../lib/i18n";
import { getWindowsChangelogFeed } from "../lib/windows-changelog";
import { getTranslation } from "../lib/translations";
import { Footer } from "./footer";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";

type ChangelogPlatform = "macos" | "windows";

interface Props {
  locale: Locale;
  platform?: ChangelogPlatform;
}

const { locale, platform = "macos" } = Astro.props;
const t = getTranslation(locale);
const copy = t.changelog;
const isWindows = platform === "windows";
const meta = isWindows ? t.meta.changelogWindows : t.meta.changelog;
const macPath = "/changelog";
const windowsPath = "/changelog/windows";
const path = isWindows ? windowsPath : macPath;

// macOS notes are copied from motion-space/screen-cam (changelogs/*.md, every site locale);
// Windows notes from motion-space/screen-cam-win (changelogs/windows/*.md, English and Simplified Chinese).
const macChangelogs = import.meta.glob("../../changelogs/*.md", { eager: true });
const windowsChangelogs = import.meta.glob("../../changelogs/windows/*.md", { eager: true });
const changelogs = isWindows ? windowsChangelogs : macChangelogs;
const directory = isWindows ? "../../changelogs/windows" : "../../changelogs";
const localizedModule = changelogs[`${directory}/${locale}.md`];
const changelogModule = (localizedModule ?? changelogs[`${directory}/${defaultLocale}.md`]) as { Content: any };
const Content = changelogModule.Content;
const showsFallbackNote = isWindows && !localizedModule;
const windowsEntries = isWindows ? getWindowsChangelogFeed(siteUrl).versions : [];
const windowsNotesLocale = locale === "zh-Hans" ? "zh-Hans" : "en";
const rangeCopy = locale === "zh-Hans" ? {
  title: "从 {from} 到 {to} 的更新内容",
  missing: "这一版本的更新日志尚未同步，请稍后重试。",
  invalid: "更新日志的版本范围无效。",
  all: "查看所有版本",
} : {
  title: "Changes from {from} to {to}",
  missing: "Release notes for this version are not available yet. Please try again later.",
  invalid: "The release-note version range is invalid.",
  all: "View all versions",
};
const platforms = [
  { id: "macos", label: "macOS", href: localizedPath(locale, macPath) },
  { id: "windows", label: "Windows", href: localizedPath(locale, windowsPath) },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead locale={locale} path={path} title={meta.title} description={meta.description} />
  </head>
  <body class="font-sans antialiased bg-background text-foreground">
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <SiteHeader
      copy={t.header}
      currentPath={macPath}
      languagePath={path}
      languageLabel={t.footer.language}
      locale={locale}
      client:load
    />

    <main id="main" class="legal-page changelog-page">
      <article class="legal-document changelog-document">
        <div class="changelog-hero">
          <div>
            <p class="eyebrow">{copy.eyebrow}</p>
            <h1>{isWindows ? copy.windowsTitle : copy.title}</h1>
            <p class="legal-updated">{isWindows ? copy.windowsIntro : copy.intro}</p>
          </div>
          <nav class="changelog-platforms" aria-label={copy.platformLabel}>
            {
              platforms.map((item) => (
                <a href={item.href} aria-current={item.id === platform ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          {showsFallbackNote && <p class="changelog-fallback-note">{copy.windowsFallbackNote}</p>}
        </div>

        {isWindows && <div id="windows-changelog-range" class="mb-10" hidden
          data-title={rangeCopy.title} data-missing={rangeCopy.missing} data-invalid={rangeCopy.invalid}>
          <h2 data-range-title></h2>
          <p data-range-message role="status"></p>
          <a href={localizedPath(locale, windowsPath)}>{rangeCopy.all}</a>
        </div>}
        <div class="changelog-markdown">
          {isWindows ? windowsEntries.map((entry) => (
            <div class="windows-changelog-release" data-windows-changelog-version={entry.version}>
              <h1 id={entry.version.replaceAll(".", "")}>{entry.version}</h1>
              <ul>{entry.notes[windowsNotesLocale].map((note) => <li>{note}</li>)}</ul>
            </div>
          )) : <Content />}
        </div>
      </article>
    </main>

    <script define:vars={{ linkVersionLabel: copy.linkVersionLabel }}>
      for (const heading of document.querySelectorAll(".changelog-markdown h1[id]")) {
        if (heading.querySelector("a")) continue;

        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        link.setAttribute("aria-label", `${linkVersionLabel} ${heading.textContent}`);

        heading.textContent = "";
        heading.append(link);
      }
    </script>

    <script>
      import { selectChangelogRange } from "../lib/windows-changelog-range";
      const rangePanel = document.getElementById("windows-changelog-range");
      if (rangePanel) {
        const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-windows-changelog-version]"));
        const result = selectChangelogRange(window.location.search, sections.map((section) => section.dataset.windowsChangelogVersion!));
        if (result.status !== "all") {
          rangePanel.hidden = false;
          const title = rangePanel.querySelector<HTMLElement>("[data-range-title]")!;
          const message = rangePanel.querySelector<HTMLElement>("[data-range-message]")!;
          title.textContent = result.status === "invalid" ? rangePanel.dataset.invalid! :
            rangePanel.dataset.title!.replace("{from}", result.from).replace("{to}", result.to);
          message.textContent = result.status === "missing" ? rangePanel.dataset.missing! : "";
          message.hidden = result.status !== "missing";
          const included = new Set(result.status === "ready" ? result.versions : []);
          for (const section of sections) section.hidden = !included.has(section.dataset.windowsChangelogVersion!);
          sections.find((section) => !section.hidden)?.classList.add("first-visible-release");
        }
      }
    </script>

    <Footer copy={t.footer} locale={locale} showProductLinks={false} client:load />
  </body>
</html>
