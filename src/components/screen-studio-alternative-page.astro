---
import "../styles/global.css";
import { appStoreUrl, localizedPath, siteUrl } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { getScreenStudioAlternativeCopy } from "../lib/screen-studio-alternative";
import { getTranslation, richTextToPlain } from "../lib/translations";
import { FAQSection } from "./faq-section";
import { Footer } from "./footer";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";
import { SmoothScroll } from "./smooth-scroll";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const copy = getScreenStudioAlternativeCopy(locale);
const path = "/screen-studio-alternative";
const pageUrl = `${siteUrl}${localizedPath(locale, path)}`;
const screenStudioUrl = "https://screen.studio/";
const benchmarkUrl = "https://benchmark.thescreen.cam";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: copy.meta.title,
      description: copy.meta.description,
      dateModified: "2026-06-13",
      inLanguage: locale,
      about: copy.schema.about.map((name) => ({ "@type": "Thing", name })),
      mentions: [
        { "@type": "SoftwareApplication", name: "Screen Studio", url: screenStudioUrl },
        { "@id": `${siteUrl}/#software` },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "ScreenCam",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: copy.schema.breadcrumbName,
          item: pageUrl,
        },
      ],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "ScreenCam",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "macOS 15+",
      url: siteUrl,
      image: `${siteUrl}/og.jpg`,
      downloadUrl: appStoreUrl,
      description: copy.schema.softwareDescription,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        url: appStoreUrl,
      },
      featureList: copy.schema.featureList,
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: copy.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: richTextToPlain(item.answer),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead
      locale={locale}
      path={path}
      title={copy.meta.title}
      description={copy.meta.description}
      robots="index, follow, max-image-preview:large"
      structuredData={structuredData}
    />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <SmoothScroll client:media="(hover: hover) and (pointer: fine)" />
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <SiteHeader
      copy={t.header}
      currentPath={path}
      languagePath={path}
      languageLabel={t.footer.language}
      locale={locale}
      client:load
    />

    <main id="main" class="pt-16">
      <section class="relative bg-background">
        <div class="rails overflow-hidden">
          <img
            src="/og.jpg"
            alt={copy.imageAlt}
            class="sr-only"
            loading="eager"
          />
          <div class="grid-paper pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,#000,transparent)]" aria-hidden="true"></div>
          <div class="relative z-10 px-6 pb-16 pt-20 md:px-10 md:pb-20 md:pt-28">
            <p class="section-eyebrow">
              {copy.hero.eyebrow}
            </p>
            <h1 class="max-w-5xl text-[clamp(3rem,7.6vw,7rem)] font-medium leading-[0.92] tracking-[-0.05em] text-foreground text-balance">
              {copy.hero.title}
            </h1>
            <div class="mt-12 grid gap-10 md:grid-cols-12 md:items-end">
              <p class="lead max-w-xl md:col-span-6">
                {copy.hero.description}
              </p>
              <div class="flex flex-col gap-3 sm:flex-row md:col-span-6 md:justify-end">
                <a class="btn-primary w-fit" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
                  <span class="rec-dot" aria-hidden="true"></span>
                  {copy.hero.appStoreCta}
                </a>
                <a class="btn-secondary w-fit" href={benchmarkUrl} target="_blank" rel="noopener noreferrer">
                  {copy.hero.benchmarkCta}
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="rails rule-top">
          <div class="cells grid-cols-2 md:grid-cols-4">
            {copy.performanceHighlights.map((item, index) => (
              <div class="group p-6 transition-colors hover:!bg-card md:p-10">
                <p class="kicker mb-8"><span class="kicker-index">{String(index + 1).padStart(2, "0")}</span></p>
                <p class="text-[clamp(2.5rem,5vw,4.5rem)] font-medium leading-none tracking-[-0.05em] text-foreground transition-colors group-hover:text-accent">{item.value}</p>
                <p class="kicker mt-4">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="rails rule-top px-6 py-4 md:px-10">
          <p class="kicker">{copy.hero.lastUpdatedLabel} {copy.lastUpdated}</p>
        </div>
      </section>

      <section class="bg-background" aria-labelledby="why-switch-title">
        <div class="rails rule-top grid md:grid-cols-12">
          <div class="px-6 pb-12 pt-16 md:col-span-5 md:px-10 md:pb-24 md:pt-24">
            <div class="md:sticky md:top-28">
              <p class="section-eyebrow">{copy.whySwitch.eyebrow}</p>
              <h2 id="why-switch-title" class="display-sm">
                {copy.whySwitch.title}
              </h2>
              <p class="lead mt-6">
                {copy.whySwitch.description}
              </p>
            </div>
          </div>
          <div class="border-t border-rule md:col-span-7 md:border-l md:border-t-0">
            {copy.performanceHighlights.map((item) => (
              <article class="group border-b border-rule px-6 py-8 transition-colors last:border-b-0 hover:bg-card md:px-10 md:py-10">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="text-3xl font-medium tracking-[-0.04em] text-foreground">{item.value}</h3>
                  <p class="kicker text-right">{item.label}</p>
                </div>
                <p class="mt-4 max-w-xl text-[15px] leading-7 text-muted-foreground">{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-background" aria-labelledby="feature-title">
        <div class="rails rule-top">
          <div class="px-6 pb-14 pt-16 md:px-10 md:pb-20 md:pt-24">
            <p class="section-eyebrow">{copy.features.eyebrow}</p>
            <h2 id="feature-title" class="display max-w-4xl">
              {copy.features.title}
            </h2>
          </div>
          <div class="cells border-t border-rule md:grid-cols-2 lg:grid-cols-3">
            {copy.features.items.map((feature, index) => (
              <article class="group relative p-6 transition-colors hover:!bg-card md:p-10">
                <span class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
                <p class="kicker mb-10"><span class="kicker-index">{String(index + 1).padStart(2, "0")}</span></p>
                <h3 class="text-xl font-medium tracking-[-0.02em] text-foreground">{feature.title}</h3>
                <p class="mt-3 text-[15px] leading-7 text-muted-foreground">{feature.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-background" aria-labelledby="comparison-title">
        <div class="rails rule-top">
          <div class="px-6 pb-14 pt-16 md:px-10 md:pb-20 md:pt-24">
            <p class="section-eyebrow">{copy.comparison.eyebrow}</p>
            <h2 id="comparison-title" class="display max-w-4xl">
              {copy.comparison.title}
            </h2>
            <p class="lead mt-6 max-w-2xl">
              {copy.comparison.description}
            </p>
          </div>

          <div class="overflow-x-auto border-t border-rule">
            <table class="w-full min-w-[780px] border-collapse text-left text-sm">
              <thead class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                <tr>
                  <th class="w-[20%] border-b border-rule px-6 py-4 font-medium md:px-10">{copy.comparison.headers.feature}</th>
                  <th class="w-[40%] border-b border-l border-rule px-6 py-4 font-medium">{copy.comparison.headers.screenStudio}</th>
                  <th class="w-[40%] border-b border-l border-rule px-6 py-4 font-medium text-foreground"><span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-accent align-middle"></span>{copy.comparison.headers.screenCam}</th>
                </tr>
              </thead>
              <tbody>
                {copy.comparison.rows.map((row) => (
                  <tr class="border-b border-rule transition-colors last:border-b-0 hover:bg-card">
                    <th class="align-top px-6 py-5 text-sm font-medium text-foreground md:px-10">{row.feature}</th>
                    <td class="align-top border-l border-rule px-6 py-5 leading-6 text-muted-foreground">{row.screenStudio}</td>
                    <td class="align-top border-l border-rule px-6 py-5 leading-6 text-foreground">{row.screenCam}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="bg-background" aria-labelledby="use-cases-title">
        <div class="rails rule-top grid md:grid-cols-2">
          <div class="px-6 pb-12 pt-16 md:px-10 md:pb-24 md:pt-24">
            <p class="section-eyebrow">{copy.bestFit.eyebrow}</p>
            <h2 id="use-cases-title" class="display-sm">
              {copy.bestFit.title}
            </h2>
            <ul class="mt-10 border-t border-rule">
              {copy.bestFit.items.map((item, index) => (
                <li class="flex gap-5 border-b border-rule py-4 text-[15px] leading-6 text-foreground">
                  <span class="pt-0.5 font-mono text-[11px] tracking-[0.1em] text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="grid-paper border-t border-rule px-6 pb-16 pt-16 md:border-l md:border-t-0 md:px-10 md:pt-24">
            <p class="section-eyebrow">{copy.bestFit.gapEyebrow}</p>
            <h3 class="text-3xl font-medium tracking-[-0.04em] text-foreground">{copy.bestFit.gapTitle}</h3>
            <p class="lead mt-5">
              {copy.bestFit.gapDescription}
            </p>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a class="btn-primary" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
                {copy.bestFit.pricingCta}
              </a>
              <a class="btn-secondary" href={screenStudioUrl} target="_blank" rel="noopener noreferrer">
                {copy.bestFit.screenStudioCta}
              </a>
            </div>
          </div>
        </div>
      </section>

      <FAQSection copy={copy.faq} client:visible={{ rootMargin: "-25% 0px" }} />
    </main>

    <Footer copy={t.footer} locale={locale} client:visible={{ rootMargin: "-25% 0px" }} />
  </body>
</html>
