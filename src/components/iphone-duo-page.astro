---
import "../styles/global.css";
import { appStoreUrl, localizedPath, siteUrl } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { duoHelperDownloadUrl, getIphoneDuoCopy, iphoneDuoPath } from "../lib/iphone-duo";
import { getTranslation } from "../lib/translations";
import { Footer } from "./footer";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";
import { SmoothScroll } from "./smooth-scroll";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const copy = getIphoneDuoCopy(locale);
const path = iphoneDuoPath;
const pageUrl = `${siteUrl}${localizedPath(locale, path)}`;
const downloadStepIndex = 2;
const dateModified = "2026-11-04";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${pageUrl}#article`,
      url: pageUrl,
      headline: copy.hero.title,
      name: copy.meta.title,
      description: copy.meta.description,
      inLanguage: locale,
      dateModified,
      image: `${siteUrl}/og.jpg`,
      author: { "@type": "Organization", name: "ScreenCam", url: siteUrl },
      publisher: { "@type": "Organization", name: "ScreenCam", url: siteUrl },
      about: copy.schema.about.map((name) => ({ "@type": "Thing", name })),
      mainEntityOfPage: pageUrl,
      mentions: [{ "@id": `${pageUrl}#duo-helper` }, { "@id": `${siteUrl}/#software` }],
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: copy.steps.title,
      description: copy.hero.description,
      inLanguage: locale,
      supply: copy.requirements.items.map((name) => ({ "@type": "HowToSupply", name })),
      tool: [
        { "@type": "HowToTool", name: "Xcode" },
        { "@type": "HowToTool", name: "ScreenCam Duo Helper" },
      ],
      step: copy.steps.items.map((step, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: step.title,
        text: step.body,
        url: `${pageUrl}#step-${index + 1}`,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#troubleshooting`,
      inLanguage: locale,
      mainEntity: copy.troubleshooting.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#duo-helper`,
      name: "ScreenCam Duo Helper",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "macOS 15 or later (Apple silicon)",
      description: copy.schema.helperDescription,
      downloadUrl: duoHelperDownloadUrl,
      installUrl: pageUrl,
      url: pageUrl,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@type": "Organization", name: "ScreenCam", url: siteUrl },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "ScreenCam",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "macOS 15+",
      url: siteUrl,
      downloadUrl: appStoreUrl,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ScreenCam", item: `${siteUrl}${localizedPath(locale, "/")}` },
        { "@type": "ListItem", position: 2, name: copy.breadcrumbName, item: pageUrl },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead
      locale={locale}
      path={path}
      title={copy.meta.title}
      description={copy.meta.description}
      robots="index, follow, max-image-preview:large"
      structuredData={structuredData}
    />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <SmoothScroll client:media="(hover: hover) and (pointer: fine)" />
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <SiteHeader
      copy={t.header}
      currentPath={path}
      languagePath={path}
      languageLabel={t.footer.language}
      locale={locale}
      client:load
    />

    <main id="main" class="pt-16">
      <article>
        <header class="relative bg-background">
          <div class="rails overflow-hidden">
            <div class="grid-paper pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,#000,transparent)]" aria-hidden="true"></div>
            <div class="relative z-10 px-6 pb-16 pt-20 md:px-10 md:pb-20 md:pt-28">
              <p class="section-eyebrow">{copy.hero.eyebrow}</p>
              <h1 class="max-w-5xl text-[clamp(2.6rem,6vw,5.5rem)] font-medium leading-[0.95] tracking-[-0.05em] text-foreground text-balance">
                {copy.hero.title}
              </h1>
              <div class="mt-12 grid gap-10 md:grid-cols-12 md:items-end">
                <p class="lead max-w-xl md:col-span-7">{copy.hero.description}</p>
                <div class="flex flex-col gap-3 sm:flex-row md:col-span-5 md:justify-end">
                  <a class="btn-primary w-fit" href={duoHelperDownloadUrl}>
                    <span class="rec-dot" aria-hidden="true"></span>
                    {copy.hero.downloadCta}
                  </a>
                  <a class="btn-secondary w-fit" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
                    {copy.hero.appStoreCta}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </header>

        <section class="bg-background" aria-labelledby="requirements-title" id="requirements">
          <div class="rails rule-top grid md:grid-cols-12">
            <div class="px-6 pb-8 pt-16 md:col-span-5 md:px-10 md:pb-24 md:pt-24">
              <p class="section-eyebrow">{copy.requirements.eyebrow}</p>
              <h2 id="requirements-title" class="display-sm">{copy.requirements.title}</h2>
            </div>
            <ul class="px-6 md:col-span-7 md:px-10 md:pt-24">
              {copy.requirements.items.map((item, index) => (
                <li class="flex gap-5 border-b border-rule py-5 text-[15px] leading-7 text-foreground first:border-t">
                  <span class="pt-1 font-mono text-[11px] tracking-[0.1em] text-muted-foreground" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="bg-background" aria-labelledby="steps-title" id="steps">
          <div class="rails rule-top">
            <div class="px-6 pb-12 pt-16 md:px-10 md:pb-16 md:pt-24">
              <p class="section-eyebrow">{copy.steps.eyebrow}</p>
              <h2 id="steps-title" class="display-sm max-w-4xl">{copy.steps.title}</h2>
            </div>
            <ol class="cells px-6 md:grid-cols-2 md:px-10">
              {copy.steps.items.map((step, index) => (
                <li id={`step-${index + 1}`} class="p-6 md:p-10">
                  <p class="kicker mb-8">
                    <span class="kicker-index">{String(index + 1).padStart(2, "0")}</span>
                    <span class="sr-only">{copy.steps.stepLabel} {index + 1}</span>
                  </p>
                  <h3 class="text-xl font-medium tracking-[-0.02em] text-foreground">{step.title}</h3>
                  <p class="mt-3 text-[15px] leading-7 text-muted-foreground">{step.body}</p>
                  {index === downloadStepIndex && (
                    <a class="btn-primary mt-6 w-fit" href={duoHelperDownloadUrl}>
                      {copy.download.button}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section class="bg-background" aria-labelledby="download-title" id="download">
          <div class="rails rule-top px-6 pt-16 md:px-10 md:pt-24">
            <div class="surface-card grid-paper grid gap-8 p-6 md:grid-cols-12 md:items-end md:p-10">
              <div class="md:col-span-8">
                <p class="section-eyebrow">{copy.download.eyebrow}</p>
                <h2 id="download-title" class="display-sm">{copy.download.title}</h2>
                <p class="lead mt-6 max-w-2xl">{copy.download.description}</p>
                <p class="kicker mt-6">{copy.download.details}</p>
              </div>
              <div class="md:col-span-4 md:flex md:justify-end">
                <a class="btn-accent w-fit" href={duoHelperDownloadUrl}>
                  {copy.download.button}
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="bg-background" aria-labelledby="notes-title" id="about-helper">
          <div class="rails rule-top grid md:grid-cols-12">
            <div class="px-6 pb-8 pt-16 md:col-span-5 md:px-10 md:pb-24 md:pt-24">
              <p class="section-eyebrow">{copy.notes.eyebrow}</p>
              <h2 id="notes-title" class="display-sm">{copy.notes.title}</h2>
            </div>
            <ul class="px-6 md:col-span-7 md:px-10 md:pt-24">
              {copy.notes.items.map((item) => (
                <li class="flex gap-4 border-b border-rule py-5 text-[15px] leading-7 text-foreground first:border-t">
                  <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="bg-background" aria-labelledby="troubleshooting-title" id="troubleshooting">
          <div class="rails rule-top px-6 pb-24 pt-16 md:px-10 md:pb-32 md:pt-24">
            <p class="section-eyebrow">{copy.troubleshooting.eyebrow}</p>
            <h2 id="troubleshooting-title" class="display-sm">{copy.troubleshooting.title}</h2>
            <div class="mt-10 border-t border-rule">
              {copy.troubleshooting.items.map((item) => (
                <div class="grid gap-3 border-b border-rule py-6 md:grid-cols-12 md:gap-10">
                  <h3 class="text-lg font-medium tracking-[-0.02em] text-foreground md:col-span-5">{item.question}</h3>
                  <p class="text-[15px] leading-7 text-muted-foreground md:col-span-7">{item.answer}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      </article>
    </main>

    <Footer copy={t.footer} locale={locale} client:visible={{ rootMargin: "-25% 0px" }} />
  </body>
</html>
